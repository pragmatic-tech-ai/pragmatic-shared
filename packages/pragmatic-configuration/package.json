{
  "name": "@pragmatic-tech-ai/pragmatic-configuration",
  "version": "0.18.7",
  "license": "Apache-2.0",
  "description": "Component configuration: the versioned configuration repository (versions, apply records; in-memory and Postgres), the applied-configuration object written next to a deployment, and the runtime reader a component calls at start.",
  "repository": {
    "type": "git",
    "url": "https://github.com/pragmatic-tech-ai/pragmatic-shared.git",
    "directory": "packages/pragmatic-configuration"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pragmatic-tech-ai/pragmatic-component": "0.18.7",
    "@pragmatic-tech-ai/pragmatic-configuration-runtime": "0.18.7",
    "@pragmatic-tech-ai/pragmatic-identity": "0.18.7",
    "@pragmatic-tech-ai/pragmatic-realm-adapters": "0.18.7"
  },
  "peerDependencies": {
    "@pragmatic-tech-ai/todl": "file:../../../TODL",
    "@pragmatic-tech-ai/todl-runtime": "file:../../../todl-runtime"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "pg-mem": "^3.0.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
