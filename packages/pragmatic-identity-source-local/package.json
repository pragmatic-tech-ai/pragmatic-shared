{
  "name": "@pragmatic-tech-ai/pragmatic-identity-source-local",
  "version": "0.16.1",
  "license": "Apache-2.0",
  "description": "Local-accounts identity source (argon2id, encrypted store, service tokens).",
  "repository": {
    "type": "git",
    "url": "https://github.com/pragmatic-tech-ai/pragmatic-shared.git",
    "directory": "packages/pragmatic-identity-source-local"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pragmatic-tech-ai/pragmatic-identity": "0.16.1",
    "hash-wasm": "^4.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
