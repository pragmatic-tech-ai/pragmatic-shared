{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "{{DistDir}}",
    "rootDir": "{{SourceDir}}"
  },
  "include": ["{{SourceDir}}"]
}
